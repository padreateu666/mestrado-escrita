{"latex-workshop.latex.tools": [
    {
        "name": "pdflatex",
        "command": "pdflatex",
        "args": [
            "-synctex=1",
            "-interaction=nonstopmode",
            "%DOC%"
        ]
    },
    {
        "name": "bibtex",
        "command": "bibtex",
        "args": [
            "%DOCFILE%"
        ]
    },
    {
        "name": "makeindex",
        "command": "makeindex",
        "args": [
            "%DOCFILE%.nlo",
            "-s",
            "nomencl.ist",
            "-o",
            "%DOCFILE%.nls"
        ]
    },
    {
        "name": "pdflatex final",
        "command": "pdflatex",
        "args": [
            "-synctex=1",
            "-interaction=nonstopmode",
            "%DOC%"
        ]
    },
    {
        "name": "cleanup",
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-Command",
            "Remove-Item -ErrorAction SilentlyContinue '%DOC%.aux','%DOC%.bbl','%DOC%.blg','%DOC%.fdb_latexmk','%DOC%.fls','%DOC%.lof','%DOC%.log','%DOC%.lot','%DOC%.nlo','%DOC%.nls','%DOC%.out','%DOC%.toc'"
        ]
    }
],
"latex-workshop.latex.recipes": [
    {
        "name": "pdflatex -> bibtex -> makeindex -> pdflatex x2",
        "tools": [
            "pdflatex",
            "bibtex",
            "makeindex",
            "pdflatex final",
            "pdflatex final",
            "cleanup"
        ]
    }
],
"latex-workshop.latex.autoBuild.run": "onSave",
}