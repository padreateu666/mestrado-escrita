   pages = {1496},
   publisher = {Multidisciplinary Digital Publishing Institute},
   title = {Review of Core Annular Flow},
   volume = {16},
   url = {https://www.mdpi.com/1996-1073/16/3/1496/htm https://www.mdpi.com/1996-1073/16/3/1496},
